<?xml version="1.0" encoding="utf-8"?>
<!--
  Takumi Anything MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build takumi-anything.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc takumi-anything.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\Takumi Anything by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch Takumi Anything" box. Installs a Start Menu shortcut and an
  App Paths entry (Win+R "takumi-anything"), plus takumi-anything-cli when HasCli=1. No file types are
  claimed: Takumi Anything opens anything, so it never takes over another app's default.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed forever (generated once for the OSCraft name and kept for Takumi Anything, so
  installing Takumi Anything removes an OSCraft install; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Takumi Anything"
      Manufacturer="Aleksandr Mitroshenkov"
      Version="$(var.Version)"
      UpgradeCode="D0D3AFC4-D5DA-45EB-95EA-3B1574CA8EB3"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Takumi Anything: find out how any software works" Manufacturer="Aleksandr Mitroshenkov" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Takumi Anything is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="TakumiAnythingIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TakumiAnythingIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Mitroshenkov87/takumi-anything" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Mitroshenkov87/takumi-anything/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Mitroshenkov87/takumi-anything/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Takumi Anything" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by TakumiAnythingApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Takumi Anything" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Takumi Anything" Level="1">
      <ComponentGroupRef Id="TakumiAnythingFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTakumiAnything"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through takumi-anything.en-us.wxl. -->
    <Property Id="TakumiAnythingVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Takumi Anything $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Takumi Anything" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#TakumiAnythingExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchTakumiAnything" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="TakumiAnythingFiles" Directory="INSTALLFOLDER">
      <Component Id="TakumiAnythingApp" Guid="85938FED-AA10-4D3C-9BD1-C470FBF974A7">
        <File Id="TakumiAnythingExe" Source="$(var.BinDir)\takumi-anything.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Takumi Anything"
              Description="Find out how any software works, then craft your own" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="TakumiAnythingIcon.exe" IconIndex="0" />
        </File>

        <!-- The "Open with" app list (any file) and the Run dialog (Win+R "takumi-anything"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\takumi-anything.exe" Name="FriendlyAppName" Value="Takumi Anything" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\takumi-anything.exe\shell\open\command" Value="&quot;[#TakumiAnythingExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\takumi-anything.exe" Value="[#TakumiAnythingExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Takumi Anything" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="TakumiAnythingCli">
        <File Id="TakumiAnythingCliExe" Source="$(var.BinDir)\takumi-anything-cli.exe" KeyPath="yes" />
        <!-- Win+R "takumi-anything-cli" and process-search by App Paths. -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\takumi-anything-cli.exe" Value="[#TakumiAnythingCliExe]" Type="string" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
